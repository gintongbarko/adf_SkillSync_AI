        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var maxResumeSkills = 10;

    if (current.getValue('u_source') != 'resume')
        return;

    var profileSysId = current.getValue('u_profile');
    if (!profileSysId)
        return;

    var gr = new GlideRecord('x_2311790_skills_0_student_skill');
    gr.addQuery('u_profile', profileSysId);
    gr.addQuery('u_source', 'resume');
    gr.query();

    if (gr.getRowCount() >= maxResumeSkills) {
        current.setAbortAction(true);
        gs.addErrorMessage('Max ' + maxResumeSkills + ' resume-derived skills per profile.');
    }
})(current, previous);]]></script>
