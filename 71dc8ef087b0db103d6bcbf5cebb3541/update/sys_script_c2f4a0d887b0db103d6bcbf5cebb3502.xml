        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var profileSysId = current.getValue('table_sys_id');
    if (!profileSysId)
        return;

    var profile = new GlideRecord('x_2311790_skills_0_student_profile');
    if (!profile.get(profileSysId))
        return;

    profile.setValue('u_parse_status', 'pending');
    profile.setValue('u_parse_error', '');
    profile.setValue('u_parse_attempts', 0);
    profile.setValue('u_parsed_attachment_sys_id', current.getUniqueValue());
    profile.setValue('u_headline', '');
    profile.setValue('u_parsed_resume', '');
    profile.update();
})(current, previous);
]]></script>
